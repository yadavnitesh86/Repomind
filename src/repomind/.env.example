# Groq API Key - Get your free API key from: https://console.groq.com/keys [[1]]
# Sign up/login at https://console.groq.com/login, then navigate to API Keys section and click "Create API Key" [[4]][[6]]
GROQ_API_KEY= # Your Groq API key (alternative providers can be configured in code)


# Hugging Face Token - Generate from: https://huggingface.co/settings/tokens [[9]]
# Go to your profile → Settings → Access Tokens → Click "New token" → Choose appropriate permissions [[14]]
HF_TOKEN= # Hugging Face access token for model access


# Qdrant Configuration - Cloud dashboard: https://cloud.qdrant.io/ [[16]]
# After creating a cluster, copy the URL from Cluster Details page [[22]]
QDRANT_URL= # Your Qdrant cluster URL (e.g., https://your-cluster-id.aws.cloud.qdrant.io)


# Qdrant API Key - From Cloud Dashboard: API Keys section of Cluster Detail Page [[16]]
# Click "Create" to generate a new API key with desired permissions [[16]]
QDRANT_API_KEY= # Your Qdrant cluster API key


# Optional: GitHub Personal Access Token - Only needed if using GitHub MCP
# Create at: https://github.com/settings/tokens [[30]]
# Navigate to Settings → Developer settings → Personal access tokens → Generate new token [[28]]
GITHUB_PERSONAL_ACCESS_TOKEN= # GitHub PAT with required scopes (repo, workflow, etc.)